# Base URL (origin) of the SmartSplit backend API — no trailing slash, no /api.
# The app appends "/api" itself.
# Local dev: leave unset to use the default http://localhost:5000
# Production (Vercel): set to your deployed Render backend URL, e.g.
#   https://smartsplit-api.onrender.com
VITE_API_URL=http://localhost:5000
