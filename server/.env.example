# MongoDB connection string (e.g. from MongoDB Atlas)
MONGO_URI=your_mongodb_connection_string

# Secret used to sign JWTs — use a long, random string in production
JWT_SECRET=your_jwt_secret

# Port the server listens on. Locally defaults to 5000 if unset.
# On Render this is provided automatically — do not hardcode it there.
PORT=5000

# Origin of the deployed frontend, used for CORS (no trailing slash).
# Local dev falls back to http://localhost:5173 automatically.
# Production (Render): set to your Vercel URL, e.g. https://smartsplit.vercel.app
CLIENT_URL=http://localhost:5173
